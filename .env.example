# ---------------------------------------------------------------------------
# Site URL — used for canonical links, sitemap.xml, robots.txt and Open Graph.
# Set this on your host (e.g. Vercel project settings) for every environment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://abhirajgovind.dev

# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com, free tier is plenty)
#
# 1. Create an account and grab an API key.
# 2. Until you verify a domain, Resend only delivers to the address you signed
#    up with, and `from` must stay as onboarding@resend.dev.
# 3. Without RESEND_API_KEY the form returns an honest error and shows the
#    visitor a mailto: fallback — it never fakes a successful send.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=abhirajg67@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
